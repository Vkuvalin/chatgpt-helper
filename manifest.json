{
  "manifest_version": 3,
  "name": "chatgpt-helper",
  "version": "1.1.0",
  "description": "Шаблоны, быстрые действия и анализ английских терминов для ChatGPT.",
  "icons": {
    "16": "icons/chatgpt-helper-16.png",
    "32": "icons/chatgpt-helper-32.png",
    "48": "icons/chatgpt-helper-48.png",
    "128": "icons/chatgpt-helper-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "chatgpt-helper",
    "default_icon": {
      "16": "icons/chatgpt-helper-16.png",
      "32": "icons/chatgpt-helper-32.png",
      "48": "icons/chatgpt-helper-48.png",
      "128": "icons/chatgpt-helper-128.png"
    }
  },
  "commands": {
    "analyze-selection": {
      "description": "Анализировать выделенный текст"
    },
    "translate-selection": {
      "description": "Перевести выделенный текст"
    },
    "save-selection": {
      "description": "Сохранить выделенный текст"
    },
    "normalize-composer": {
      "description": "Нормализовать пустые строки в поле ввода"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/workspace-contract.js",
        "src/conversation-context.js",
        "src/command-registry.js",
        "src/chatgpt-dom.js",
        "src/analysis-contract.js",
        "src/analysis-controller.js",
        "src/translation-controller.js",
        "src/analysis-ui.js",
        "src/workspace-ui.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
