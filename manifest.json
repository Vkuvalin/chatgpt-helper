{
  "manifest_version": 3,
  "name": "ChatGPT Templates",
  "version": "1.0.2",
  "description": "Добавляет в ChatGPT оверлей с шаблонами и быстрой отправкой.",
  "icons": {
    "16": "icons/plan-runner-16.png",
    "32": "icons/plan-runner-32.png",
    "48": "icons/plan-runner-48.png",
    "128": "icons/plan-runner-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "Шаблоны ChatGPT",
    "default_icon": {
      "16": "icons/plan-runner-16.png",
      "32": "icons/plan-runner-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/chatgpt-dom.js",
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
